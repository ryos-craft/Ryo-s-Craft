<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="description" content="Ryo's Craft - 流木・木・自然素材を活かしたアート作品">
<title>Ryo's Craft | Nature becomes art.</title>

<style>
:root{
  --cream:#f3eee5;
  --ink:#211b17;
  --line:rgba(255,255,255,.42);
  --serif:Georgia,"Times New Roman","Yu Mincho","Hiragino Mincho ProN",serif;
  --sans:-apple-system,BlinkMacSystemFont,"Helvetica Neue","Hiragino Kaku Gothic ProN","Yu Gothic",Arial,sans-serif;
}

*{box-sizing:border-box}

html{
  scroll-behavior:smooth;
}

body{
  margin:0;
  background:#0e0d0c;
  color:#fff;
  font-family:var(--sans);
}

a{
  color:inherit;
  text-decoration:none;
}

img{
  display:block;
  width:100%;
  height:100%;
  object-fit:cover;
}

/* HEADER */
.site-header{
  position:fixed;
  z-index:20;
  top:0;
  left:0;
  width:100%;
  height:72px;
  background:rgba(247,243,235,.96);
  color:#1c1714;
  display:flex;
  align-items:center;
  padding:0 6vw;
  border-bottom:1px solid rgba(0,0,0,.12);
}

.logo{
  width:180px;
  font-family:cursive;
  font-size:28px;
  font-style:italic;
  line-height:1;
  color:#24160e;
  white-space:nowrap;
}

.nav{
  margin-left:auto;
  display:flex;
  align-items:center;
  gap:35px;
}

.nav a{
  font-family:var(--serif);
  font-size:11px;
  letter-spacing:.27em;
  text-transform:uppercase;
  transition:opacity .2s;
}

.nav a:hover{
  opacity:.55;
}

.nav-icons{
  display:flex;
  gap:22px;
  margin-left:34px;
  font-size:21px;
}

.menu{
  display:none;
  font-size:25px;
}

/* HERO */
.hero{
  position:relative;
  height:100vh;
  min-height:620px;
  margin-top:0;
  overflow:hidden;
}

.hero-image{
  position:absolute;
  inset:0;
}

.hero-image img{
  object-position:center;
}

.hero::after{
  content:"";
  position:absolute;
  inset:0;
  background:
    linear-gradient(
      90deg,
      rgba(0,0,0,.72) 0%,
      rgba(0,0,0,.38) 38%,
      rgba(0,0,0,.05) 72%
    );
}

.hero-content{
  position:absolute;
  z-index:2;
  left:11%;
  top:50%;
  transform:translateY(-43%);
  max-width:450px;
}

.brand-mark{
  font-family:cursive;
  font-style:italic;
  font-size:72px;
  line-height:.9;
  margin-bottom:20px;
  letter-spacing:-.05em;
}

.hero h1{
  font-family:var(--serif);
  font-size:30px;
  font-weight:400;
  letter-spacing:.12em;
  margin:0 0 18px;
}

.hero p{
  margin:0 0 20px;
  max-width:360px;
  line-height:2;
  font-size:15px;
  color:#f2eee8;
}

.kicker{
  padding-top:18px;
  border-top:1px solid var(--line);
  font-family:var(--serif);
  font-size:11px;
  letter-spacing:.28em;
  margin-bottom:25px;
}

.button{
  display:inline-flex;
  align-items:center;
  gap:16px;
  padding:13px 28px;
  border:1px solid rgba(255,255,255,.75);
  font-family:var(--serif);
  font-size:11px;
  letter-spacing:.22em;
  transition:.25s;
  background:rgba(0,0,0,.08);
}

.button:hover{
  background:#fff;
  color:#211b17;
}

/* ABOUT */
.section-title{
  font-family:var(--serif);
  letter-spacing:.25em;
  font-size:24px;
  font-weight:400;
  margin:0 0 22px;
}

.about{
  min-height:240px;
  position:relative;
  overflow:hidden;
  background:#3b2417;
}

.about-image{
  position:absolute;
  inset:0;
}

.about-image img{
  object-position:center;
}

.about::after{
  content:"";
  position:absolute;
  inset:0;
  background:
    linear-gradient(
      90deg,
      rgba(18,12,8,.84),
      rgba(18,12,8,.12)
    );
}

.about-content{
  position:relative;
  z-index:2;
  width:42%;
  padding:30px 7vw 28px;
}

.about p{
  font-size:12px;
  line-height:1.9;
  margin:0 0 12px;
}

.small-button{
  display:inline-block;
  border:1px solid rgba(255,255,255,.7);
  padding:8px 17px;
  font-family:var(--serif);
  font-size:10px;
  letter-spacing:.18em;
}

/* WORKS */
.works{
  background:#0b0b0b;
  display:grid;
  grid-template-columns:26% 74%;
  min-height:230px;
  border-top:1px solid rgba(255,255,255,.25);
}

.works-intro{
  padding:25px 7vw;
}

.works-intro p{
  font-size:12px;
  line-height:1.8;
  margin:0 0 15px;
}

.works-grid{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  height:230px;
}

.work-card{
  position:relative;
  overflow:hidden;
  border-left:1px solid rgba(255,255,255,.18);
}

.work-card img{
  transition:transform .6s;
}

.work-card:hover img{
  transform:scale(1.06);
}

.work-card span{
  position:absolute;
  left:15px;
  bottom:15px;
  font-family:var(--serif);
  font-size:10px;
  letter-spacing:.15em;
  text-shadow:0 1px 5px #000;
}

/* GALLERY */
.gallery{
  padding:90px 7vw;
  background:#171411;
}

.gallery-head{
  display:flex;
  justify-content:space-between;
  align-items:end;
  margin-bottom:30px;
}

.gallery-head p{
  font-size:12px;
  line-height:1.8;
  max-width:390px;
  color:#cfc6bd;
}

.gallery-grid{
  display:grid;
  grid-template-columns:2fr 1fr 1fr;
  gap:10px;
  height:520px;
}

.gallery-item{
  overflow:hidden;
}

.gallery-item img{
  transition:transform .6s;
}

.gallery-item:hover img{
  transform:scale(1.035);
}

/* CONTACT / SHOP / NEWS */
.contact{
  text-align:center;
  padding:95px 20px;
  background:#0b0a09;
}

.contact p{
  font-family:var(--serif);
  font-size:15px;
  line-height:2;
  color:#d6cec5;
}

/* FOOTER */
footer{
  padding:28px 7vw;
  display:flex;
  justify-content:space-between;
  background:#070707;
  color:#aaa;
  font-family:var(--serif);
  font-size:10px;
  letter-spacing:.15em;
}

/* MOBILE */
@media(max-width:800px){

  .site-header{
    height:64px;
    padding:0 20px;
  }

  .logo{
    font-size:23px;
  }

  .nav{
    display:none;
  }

  .menu{
    display:block;
    margin-left:auto;
  }

  .hero{
    min-height:720px;
  }

  .hero-content{
    left:28px;
    right:28px;
    top:52%;
  }

  .brand-mark{
    font-size:54px;
  }

  .hero h1{
    font-size:23px;
  }

  .hero p{
    font-size:13px;
  }

  .about-content{
    width:100%;
    padding:32px 28px;
  }

  .works{
    display:block;
  }

  .works-intro{
    padding:32px 28px;
  }

  .works-grid{
    height:190px;
  }

  .gallery{
    padding:65px 20px;
  }

  .gallery-head{
    display:block;
  }

  .gallery-grid{
    height:auto;
    grid-template-columns:1fr 1fr;
  }

  .gallery-item:first-child{
    grid-column:1 / -1;
    height:300px;
  }

  .gallery-item:not(:first-child){
    height:220px;
  }

  footer{
    display:block;
    text-align:center;
    line-height:2;
  }
}
</style>
</head>

<body>

<header class="site-header">
  <a class="logo" href="#home">Ryo's Craft</a>

  <nav class="nav">
    <a href="#home">Home</a>
    <a href="#about">About</a>
    <a href="#works">Works</a>
    <a href="#gallery">Gallery</a>
    <a href="#shop">Shop</a>
    <a href="#news">News</a>
    <a href="#contact">Contact</a>
  </nav>

  <div class="nav-icons" aria-label="social links">
    <a href="#" aria-label="Instagram">◎</a>
    <a href="#shop" aria-label="Shop">🛒</a>
  </div>

  <div class="menu">☰</div>
</header>

<main>

<!-- HOME -->
<section id="home" class="hero">

  <div class="hero-image">
    <img src="hero.JPG" alt="Ryo's Craft">
  </div>

  <div class="hero-content">

    <div class="brand-mark">
      Ryo's Craft
    </div>

    <h1>
      Nature becomes art.
    </h1>

    <p>
      自然の中で出会った木や流木を、<br>
      一つひとつの個性を活かして<br>
      作品にしています。
    </p>

    <div class="kicker">
      DRIFTWOOD / WOOD / LIGHT / NATURE
    </div>

    <a class="button" href="#works">
      VIEW WORKS <span>→</span>
    </a>

  </div>

</section>


<!-- ABOUT -->
<section id="about" class="about">

  <div class="about-image">
    <img src="about.JPG" alt="木と植物の素材">
  </div>

  <div class="about-content">

    <h2 class="section-title">
      ABOUT
    </h2>

    <p>
      流木、木、植物、そして光。<br>
      自然が生み出した素材の持つ美しさを活かし、<br>
      暮らしの中に溶け込むアート作品を創作しています。
    </p>

    <a class="small-button" href="#contact">
      ABOUT MORE →
    </a>

  </div>

</section>


<!-- WORKS -->
<section id="works" class="works">

  <div class="works-intro">

    <h2 class="section-title">
      WORKS
    </h2>

    <p>
      流木アート、照明、ウォールアートなど<br>
      一点ものの作品たち。
    </p>

    <a class="small-button" href="#gallery">
      VIEW ALL →
    </a>

  </div>


  <div class="works-grid">

    <a class="work-card" href="#gallery">
      <img src="works-grid.JPG" alt="作品">
      <span>DRIFTWOOD</span>
    </a>

    <a class="work-card" href="#gallery">
      <img src="hero-right.JPG" alt="照明作品">
      <span>LIGHT</span>
    </a>

    <a class="work-card" href="#gallery">
      <img src="works.JPG" alt="木の作品">
      <span>WOOD</span>
    </a>

    <a class="work-card" href="#gallery">
      <img src="hero.JPG" alt="自然素材の作品">
      <span>NATURE</span>
    </a>

  </div>

</section>


<!-- GALLERY -->
<section id="gallery" class="gallery">

  <div class="gallery-head">

    <div>

      <h2 class="section-title">
        GALLERY
      </h2>

      <p>
        自然素材の表情と、光がつくる静かな空間。<br>
        作品をゆっくりご覧ください。
      </p>

    </div>

    <a class="small-button" href="#contact">
      CONTACT →
    </a>

  </div>


  <div class="gallery-grid">

    <div class="gallery-item">
      <img src="hero-right.JPG" alt="流木の照明作品">
    </div>

    <div class="gallery-item">
      <img src="works-grid.JPG" alt="木の作品">
    </div>

    <div class="gallery-item">
      <img src="about.JPG" alt="自然素材">
    </div>

  </div>

</section>


<!-- SHOP -->
<section id="shop" class="contact">

  <h2 class="section-title">
    SHOP
  </h2>

  <p>
    作品の販売については、お気軽にお問い合わせください。
  </p>

  <a class="button" href="#contact">
    VIEW SHOP →
  </a>

</section>


<!-- NEWS -->
<section id="news" class="contact">

  <h2 class="section-title">
    NEWS
  </h2>

  <p>
    新しい作品や展示のお知らせを掲載していきます。
  </p>

</section>


<!-- CONTACT -->
<section id="contact" class="contact">

  <h2 class="section-title">
    CONTACT
  </h2>

  <p>
    作品についてのご相談・お問い合わせはこちらから。
  </p>

  <a class="button" href="mailto:your-email@example.com">
    MAIL →
  </a>

</section>

</main>


<footer>

  <span>
    © Ryo's Craft
  </span>

  <span>
    Driftwood Art &amp; Natural Wood
  </span>

</footer>

</body>
</html>
